#!/usr/bin/env bash
# Ferret Scan GUI — sets up library paths and launches the app.
set -eo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=scripts/lib/common.sh
source "${ROOT}/scripts/lib/common.sh"
ferret_export_dev_runtime
exec "$(ferret_python)" "${ROOT}/scripts/ferret_gui.py" "$@"
