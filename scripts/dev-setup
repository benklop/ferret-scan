#!/usr/bin/env bash
# Local development setup (native arch): venv, OrbbecSDK, pyorbbecsdk, libferret.
set -eo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib/common.sh
source "${ROOT}/scripts/lib/common.sh"

LIBFERRET="$(ferret_libferret_root)"
PYOB="$(ferret_pyorbbec_root)"
SDK_SRC="$(ferret_sdk_lib_dir)"
SDK_DST="${PYOB}/sdk/lib/$(ferret_pyorbbec_sdk_dirname)"
VENV="${ROOT}/.venv"

echo "==> ferret-scan dev setup ($(ferret_native_arch))"
echo "    libferret: ${LIBFERRET}"

if [[ ! -f "${LIBFERRET}/pyproject.toml" ]]; then
  echo "Initialize submodules: git submodule update --init --recursive" >&2
  exit 1
fi

if [[ ! -f "${SDK_SRC}/libOrbbecSDK.so" ]]; then
  echo "==> Building libferret (OrbbecSDK)..."
  make -C "${LIBFERRET}" sdk -j"$(nproc)"
fi

echo "==> Python venv at .venv"
PYTHON_BOOTSTRAP="python3"
VENV_FLAGS=()
if [[ -f /etc/fedora-release ]] && /usr/bin/python3 -c "import wx" 2>/dev/null; then
  echo "    Fedora: using /usr/bin/python3 + system wxPython (pip wheels mismatch wxGTK here)"
  PYTHON_BOOTSTRAP="/usr/bin/python3"
  VENV_FLAGS=(--system-site-packages)
fi
"${PYTHON_BOOTSTRAP}" -m venv "${VENV_FLAGS[@]}" "${VENV}"
# shellcheck source=/dev/null
source "${VENV}/bin/activate"
pip install -U pip wheel
if [[ "${PYTHON_BOOTSTRAP}" == "/usr/bin/python3" ]]; then
  grep -v '^wxPython' "${ROOT}/requirements.txt" | pip install -r /dev/stdin
else
  pip install -r "${ROOT}/requirements.txt"
fi
if ! "${VENV}/bin/python" -c "import wx" 2>/dev/null; then
  echo "ERROR: wxPython not available. On Fedora: sudo dnf install python3-wxpython4" >&2
  exit 1
fi

if [[ ! -d "${PYOB}/.git" ]]; then
  echo "==> Cloning pyorbbecsdk..."
  mkdir -p "$(dirname "${PYOB}")"
  git clone --depth 1 --branch v2-main https://github.com/orbbec/pyorbbecsdk.git "${PYOB}"
fi

echo "==> Syncing Ferret OrbbecSDK into pyorbbecsdk..."
rm -rf "${SDK_DST}"
mkdir -p "${SDK_DST}"
cp -a "${SDK_SRC}/"* "${SDK_DST}/"

PYBIND_DIR="$("${VENV}/bin/python" -m pybind11 --cmakedir)"
cmake -S "${PYOB}" -B "${PYOB}/build" -DCMAKE_BUILD_TYPE=Release -Dpybind11_DIR="${PYBIND_DIR}"
cmake --build "${PYOB}/build" -j"$(nproc)"
cmake --install "${PYOB}/build"

pip install -e "${PYOB}"
pip install -e "${LIBFERRET}"

echo ""
echo "Done. Run:"
echo "  ./ferret"
echo "  ./scripts/dev-check --snap"
