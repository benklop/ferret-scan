#!/usr/bin/env bash
# Local development setup (native arch): venv, OrbbecSDK, pyorbbecsdk, libferret.
set -eo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib/common.sh
source "${ROOT}/scripts/lib/common.sh"
# shellcheck source=lib/wx_build.sh
source "${ROOT}/scripts/lib/wx_build.sh"

if ! command -v uv >/dev/null 2>&1; then
  echo "Install uv: https://docs.astral.sh/uv/getting-started/installation/" >&2
  exit 1
fi

LIBFERRET="$(ferret_libferret_root)"
PYOB="$(ferret_pyorbbec_root)"
SDK_SRC="$(ferret_sdk_lib_dir)"
SDK_DST="${PYOB}/sdk/lib/$(ferret_pyorbbec_sdk_dirname)"
VENV="${ROOT}/.venv"
VENV_PY="${VENV}/bin/python"

# Always use the project venv (asdf/.python-version). Never install into system Python.
unset UV_PYTHON
export UV_PROJECT_ENVIRONMENT="${VENV}"

ferret_uv_pip() {
  uv pip install --python "${VENV_PY}" "$@"
}

echo "==> ferret-scan dev setup ($(ferret_native_arch))"
echo "    libferret: ${LIBFERRET}"

if [[ ! -f "${LIBFERRET}/pyproject.toml" ]]; then
  echo "Initialize submodules: git submodule update --init --recursive" >&2
  exit 1
fi

if [[ ! -f "${SDK_SRC}/libOrbbecSDK.so" ]]; then
  echo "==> Building libferret (OrbbecSDK)..."
  make -C "${LIBFERRET}" sdk -j"$(nproc)"
fi

echo "==> Python venv at .venv (uv + .python-version)"
cd "${ROOT}"

if [[ "$(uname -s)" == Linux ]] && ! ferret_wx_native_deps_ok; then
  echo "ERROR: wxGTK development packages required before setup." >&2
  echo >&2
  ferret_wx_print_native_deps >&2
  exit 1
fi

uv venv --clear "${VENV}"
# wxPython: pyproject [tool.uv] no-binary-package; build explicitly after other deps.
uv sync --group dev --no-install-package wxPython

if [[ "$(uname -s)" == Linux ]]; then
  ferret_uv_pip uninstall wxPython wxpython 2>/dev/null || true
  if ! ferret_build_wxpython "${VENV_PY}"; then
    exit 1
  fi
else
  ferret_uv_pip 'wxPython>=4.2'
fi

# ferret_build_wxpython already verifies import; keep a clear fallback message.
if ! ferret_verify_wx_import "${VENV_PY}" 2>/dev/null; then
  echo "ERROR: wxPython not available in ${VENV_PY}" >&2
  exit 1
fi

if [[ ! -d "${PYOB}/.git" ]]; then
  echo "==> Cloning pyorbbecsdk..."
  mkdir -p "$(dirname "${PYOB}")"
  git clone --depth 1 --branch v2-main https://github.com/orbbec/pyorbbecsdk.git "${PYOB}"
fi

echo "==> Syncing Ferret OrbbecSDK into pyorbbecsdk..."
rm -rf "${SDK_DST}"
mkdir -p "${SDK_DST}"
cp -a "${SDK_SRC}/"* "${SDK_DST}/"

if [[ -f "${PYOB}/build/CMakeCache.txt" ]]; then
  cached_py="$(grep -m1 '^PYTHON_EXECUTABLE:FILEPATH=' "${PYOB}/build/CMakeCache.txt" 2>/dev/null | cut -d= -f2- || true)"
  if [[ -n "${cached_py}" && "${cached_py}" != "${VENV_PY}" ]]; then
    echo "==> Rebuilding pyorbbecsdk (Python interpreter changed)"
    rm -rf "${PYOB}/build"
  fi
fi

PYBIND_DIR="$("${VENV_PY}" -m pybind11 --cmakedir)"
cmake -S "${PYOB}" -B "${PYOB}/build" \
  -DCMAKE_BUILD_TYPE=Release \
  -Dpybind11_DIR="${PYBIND_DIR}" \
  -DPython3_EXECUTABLE="${VENV_PY}"
cmake --build "${PYOB}/build" -j"$(nproc)"
cmake --install "${PYOB}/build"

ferret_uv_pip --force-reinstall --no-deps -e "${PYOB}"
ferret_uv_pip --force-reinstall --no-deps -e "${LIBFERRET}"

if ! "${VENV_PY}" -c "import pyorbbecsdk" 2>/dev/null; then
  echo "ERROR: pyorbbecsdk import failed after install" >&2
  echo "  Try: uv pip install --python ${VENV_PY} --force-reinstall -e ${PYOB}" >&2
  exit 1
fi

echo ""
echo "Done. Run:"
echo "  ./ferret"
echo "  ./scripts/dev-check --snap"
